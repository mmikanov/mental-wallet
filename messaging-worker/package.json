{
  "name": "mental-wallet-messaging",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:local": "wrangler d1 execute messaging-db --local --file=./migrations/0001_create_subscribers.sql",
    "db:migrate:remote": "wrangler d1 execute messaging-db --remote --file=./migrations/0001_create_subscribers.sql",
    "seed:warm-launch": "tsx scripts/seed-warm-launch.ts",
    "send:tip": "tsx scripts/send-tip.ts",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250620.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "wrangler": "4.14.4"
  }
}
