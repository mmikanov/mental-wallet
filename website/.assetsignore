# Files in this directory that should NOT be uploaded as public static assets.
# NOTE: providing this file disables wrangler's built-in default ignores, so we must
# re-list the things that should never ship (node_modules, config, tooling) alongside
# the dev-only test files.
node_modules/
tests/
tools/
.wrangler/
wrangler.toml
package.json
package-lock.json
build-content.js
.assetsignore
.DS_Store
**/.DS_Store
